# Getgas Energen — production environment variables for cPanel
#
# Add each of these in cPanel → Setup Node.js App → Environment variables.
# Do NOT commit real values to Git.

NODE_ENV=production
SITE_URL=https://getgas.co.ke

# Backend connection (browser-visible values)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Backend connection (server-side only — never expose these to the browser)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
