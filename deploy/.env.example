# Getgas Energen — production environment variables for cPanel
#
# Add each of these in cPanel → Setup Node.js App → Environment variables.
# Do NOT commit real values to Git.

NODE_ENV=production
SITE_URL=https://getgas.co.ke

# Backend connection (browser-visible values)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Backend connection (server-side only — never expose these to the browser)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Outbound email (cPanel mailbox: create it under cPanel → Email Accounts)
SMTP_HOST=mail.getgas.co.ke
SMTP_PORT=465
SMTP_USER=notifications@getgas.co.ke
SMTP_PASSWORD=
SMTP_FROM_NAME=Getgas Energen
# NOTIFY_EMAIL=getgasenergenkenya@gmail.com   # internal inbox (default)

# Kopokopo (M-Pesa) — from the Kopokopo dashboard → API settings
KOPOKOPO_CLIENT_ID=
KOPOKOPO_CLIENT_SECRET=
KOPOKOPO_TILL_NUMBER=
KOPOKOPO_API_KEY=
SITE_URL=https://getgas.co.ke

# Emalify SMS — from the Emalify v2 dashboard (getgasmsgr app)
EMALIFY_API_KEY=
EMALIFY_PARTNER_ID=
EMALIFY_SENDER_ID=GETGASKENYA

# Internal SMS alert recipient for new enquiries/quotes (defaults to +254702947573)
TEAM_ALERT_PHONE=+254702947573
